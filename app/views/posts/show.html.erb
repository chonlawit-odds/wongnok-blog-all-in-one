<% content_for :title, @post.title %>

<div class="w-full max-w-3xl mx-auto">
  <%# รับ broadcast ของโพสต์นี้ (comment ใหม่ + ตัวนับ) ผ่าน Action Cable %>
  <%= turbo_stream_from @post %>

  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success alert-soft mb-6"><%= notice %></div>
  <% end %>

  <nav class="breadcrumbs text-sm text-base-content/70 mb-4" aria-label="<%= t(".breadcrumb") %>">
    <ul>
      <li><%= link_to t(".breadcrumb_root"), posts_path %></li>
      <li aria-current="page"><%= truncate(@post.title, length: 40) %></li>
    </ul>
  </nav>

  <% unless @post.published? %>
    <div role="status" class="alert alert-info alert-soft mb-6 flex flex-wrap items-center justify-between gap-3">
      <span>
        <% if @post.scheduled? %>
          <%= t(".scheduled_notice", time: l(@post.scheduled_at, format: :long)) %>
        <% else %>
          <%= t(".draft_notice") %>
        <% end %>
      </span>
      <%# เข้าคิว PublishPostJob (Posts::PublicationsController) ไม่ได้เผยแพร่ใน request นี้ %>
      <%= button_to t(".publish_now"), post_publication_path(@post), class: "btn btn-primary btn-sm",
            data: { turbo_confirm: t(".confirm_publish_now") } %>
    </div>
  <% end %>

  <%# หน้านี้ไม่ได้ cache: มีปุ่มลบ/เผยแพร่ (CSRF token) ฟอร์ม comment และเวลาแบบ "x ที่แล้ว" %>
  <article id="<%= dom_id @post %>" class="card overflow-hidden bg-base-100 text-base-content border border-base-300 shadow-sm">
    <% if @post.cover.attached? %>
      <%# รูปเป็น signed URL ของ Active Storage (redirect ไป MinIO แบบมีวันหมดอายุ) alt ว่างเพราะหัวข้ออยู่ข้าง ๆ แล้ว %>
      <figure>
        <%= image_tag @post.cover.variant(:large), alt: "", class: "w-full max-h-[28rem] object-cover" %>
      </figure>
    <% end %>

    <div class="card-body gap-6 p-6 sm:p-10">
      <header class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/60">
          <span class="badge badge-primary badge-soft font-medium"><%= @post.category.name %></span>
          <% if @post.published? %>
            <%= time_tag @post.published_at,
                  t(".posted_ago", time: time_ago_in_words(@post.published_at)),
                  title: l(@post.published_at, format: :long) %>
          <% else %>
            <%= post_status_badge(@post) %>
            <% if @post.scheduled? %>
              <%= time_tag @post.scheduled_at, t(".scheduled_for", time: l(@post.scheduled_at, format: :short)) %>
            <% end %>
          <% end %>
          <span aria-hidden="true">·</span>
          <span><%= t("posts.reading_time", count: reading_minutes(@post)) %></span>
        </div>

        <%# แก้หัวข้อแบบ inline: id = dom_id(@post, :title) ตรงกับ posts/edit.html+turbo_frame.erb
            (ไม่ใช้ dom_id(@post) เฉย ๆ เพราะ <article> ด้านบนใช้ id นั้นแล้ว) %>
        <%= turbo_frame_tag @post, :title, class: "block" do %>
          <div class="flex items-start justify-between gap-3">
            <h1 class="text-3xl sm:text-4xl font-bold leading-tight tracking-tight"><%= @post.title %></h1>
            <%= link_to edit_post_path(@post), class: "btn btn-ghost btn-sm btn-square shrink-0",
                  title: t(".edit_title"), aria: { label: t(".edit_title") } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </header>

      <div class="divider my-0"></div>

      <%# Action Text sanitize HTML ให้เองตอน render (ตัด <script>/onclick ฯลฯ) ห้าม raw/html_safe %>
      <div class="text-lg leading-relaxed"><%= @post.body %></div>
    </div>
  </article>

  <div class="flex flex-wrap items-center gap-2 mt-6">
    <%= link_to posts_path, class: "btn btn-ghost" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      <%= t(".back") %>
    <% end %>
    <div class="ml-auto flex flex-wrap gap-2">
      <%= link_to t(".edit"), edit_post_path(@post), class: "btn btn-outline" %>
      <%= button_to t(".destroy"), @post, method: :delete, class: "btn btn-error btn-outline",
            data: { turbo_confirm: t(".confirm_destroy") } %>
    </div>
  </div>

  <section class="mt-12">
    <h2 id="<%= dom_id(@post, :comments_count) %>" class="text-xl font-bold mb-4">
      <%= render "comments/count", post: @post %>
    </h2>

    <div id="<%= dom_id(@post, :comments) %>" class="flex flex-col gap-3 mb-6">
      <%# โชว์เฉพาะตอนไม่มี comment: only:block = เป็นลูกตัวเดียวใน list %>
      <p class="hidden only:block rounded-box border border-dashed border-base-300 text-center text-base-content/60 py-8"><%= t(".no_comments") %></p>
      <%= render @comments %>
    </div>

    <%= render "comments/form", post: @post, comment: @comment %>
  </section>
</div>
