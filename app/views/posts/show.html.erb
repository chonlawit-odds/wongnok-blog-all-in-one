<% content_for :title, @post.title %>

<div class="w-full max-w-3xl mx-auto">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success mb-6"><%= notice %></div>
  <% end %>

  <nav class="breadcrumbs text-sm mb-4" aria-label="<%= t(".breadcrumb") %>">
    <ul>
      <li><%= link_to t(".breadcrumb_root"), posts_path %></li>
      <li aria-current="page"><%= truncate(@post.title, length: 40) %></li>
    </ul>
  </nav>

  <%= render @post, full: true %>

  <div class="flex flex-wrap gap-2 mt-6">
    <%= link_to t(".back"), posts_path, class: "btn btn-ghost" %>
    <%= link_to t(".edit"), edit_post_path(@post), class: "btn" %>
    <%= button_to t(".destroy"), @post, method: :delete, class: "btn btn-error",
          data: { turbo_confirm: t(".confirm_destroy") } %>
  </div>
</div>
