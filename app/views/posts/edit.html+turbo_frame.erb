<%# ฟอร์มแก้หัวข้อแบบ inline: ใช้เมื่อคำขอมาจาก turbo-frame ในหน้า show (ดู PostsController#set_turbo_frame_variant)
    id ของ frame ต้องตรงกับ posts/show.html.erb  เปิด /posts/:id/edit ตรง ๆ จะได้ edit.html.erb หน้าเต็ม %>
<%= turbo_frame_tag @post, :title, class: "block" do %>
  <%= form_with model: @post, class: "flex flex-col gap-2" do |form| %>
    <%= form.label :title, t(".title_label"), class: "sr-only" %>
    <%= form.text_field :title, autofocus: true,
          class: ["input input-lg w-full font-bold", { "input-error": @post.errors[:title].any? }] %>

    <% @post.errors.messages_for(:title).each do |message| %>
      <p class="text-sm text-error"><%= message %></p>
    <% end %>

    <div class="flex gap-2">
      <%= form.submit t(".save"), class: "btn btn-primary btn-sm" %>
      <%= link_to t(".cancel"), @post, class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
<% end %>
