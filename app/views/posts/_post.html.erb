<%# locals: (post:, full: false) -%>
<article id="<%= dom_id post %>" class="card bg-base-100 border border-base-300">
  <div class="card-body gap-3">
    <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
      <span class="badge badge-primary badge-soft"><%= post.category.name %></span>
      <%= time_tag post.created_at,
            t(".posted_ago", time: time_ago_in_words(post.created_at)),
            title: l(post.created_at, format: :long) %>
    </div>

    <% if full %>
      <%# แก้หัวข้อแบบ inline: id = dom_id(post, :title) ตรงกับ posts/edit.html+turbo_frame.erb
          (ไม่ใช้ dom_id(post) เฉย ๆ เพราะ <article> ด้านบนใช้ id นั้นแล้ว) %>
      <%= turbo_frame_tag post, :title, class: "block" do %>
        <div class="flex items-start justify-between gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold leading-snug"><%= post.title %></h1>
          <%= link_to t(".edit_title"), edit_post_path(post), class: "btn btn-ghost btn-sm shrink-0" %>
        </div>
      <% end %>
      <p class="whitespace-pre-line leading-relaxed"><%= post.description %></p>
    <% else %>
      <h2 class="card-title text-xl">
        <%= link_to post.title, post, class: "link link-hover" %>
      </h2>
      <p class="text-base-content/80 leading-relaxed">
        <%= truncate(post.description, length: 160, separator: /\s/) %>
      </p>
    <% end %>
  </div>
</article>
