<%# locals: (post:) -%>
<%# การ์ดโพสต์ในหน้ารายการ  หน้า show วาดบทความเต็มเองใน show.html.erb (template คนละไฟล์ = cache key คนละชุด)

    cache ต่อการ์ด 1 ใบ: key = digest ของ template + posts/:id  version = updated_at (cache versioning)
    ไม่ตั้งเวลาหมดอายุ: ของในกล่องเปลี่ยนเมื่อไหร่ updated_at ต้องเปลี่ยนตาม แล้วได้ key ใหม่เอง
    - แก้โพสต์ / เปลี่ยนสถานะ / เผยแพร่ตามเวลา: updated_at เปลี่ยนเอง
    - comment ใหม่ (จำนวน comment): Comment belongs_to :post, touch: true
    - เปลี่ยนรูปปก: Active Storage touch โพสต์ให้ (touch_attachment_records)
    - เปลี่ยนชื่อหมวดหมู่: Category#touch_posts

    ห้ามใส่ของเฉพาะผู้ใช้/เฉพาะ request ในกล่องนี้ (ทุกคนได้ HTML ก้อนเดียวกัน):
    ข้อมูลของผู้ใช้ที่ login, form / button_to (มี CSRF token ของแต่ละ session), flash
    และเวลาแบบ "x นาทีที่แล้ว" (ค้างอยู่อย่างนั้นจนโพสต์ถูกแก้) จึงโชว์เป็นวันที่แทน
    รูปปกเป็น URL ของ Rails ที่ไม่หมดอายุ (redirect ไป signed URL ของ MinIO ทุกครั้งที่โหลด) จึง cache ได้ -%>
<% cache post do %>
  <article id="<%= dom_id post %>"
           class="group card sm:card-side relative overflow-hidden bg-base-100 text-base-content border border-base-300 shadow-sm motion-safe:transition hover:border-primary/40 hover:shadow-lg motion-safe:hover:-translate-y-0.5 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-primary">
    <% if post.cover.attached? %>
      <%# alt ว่าง: หัวข้ออยู่ข้าง ๆ แล้ว รูปเป็นแค่ของตกแต่ง %>
      <figure class="sm:w-56 sm:shrink-0 overflow-hidden">
        <%= image_tag post.cover.variant(:thumb), alt: "", loading: "lazy",
              class: "w-full h-48 sm:h-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105" %>
      </figure>
    <% else %>
      <div aria-hidden="true" class="hidden sm:flex sm:w-56 sm:shrink-0 items-center justify-center bg-linear-to-br from-primary/15 via-base-200 to-secondary/15">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-12 text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
      </div>
    <% end %>

    <div class="card-body gap-3 min-w-0">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/60">
        <span class="badge badge-primary badge-soft font-medium"><%= post.category.name %></span>
        <% if post.published? %>
          <%= time_tag post.published_at, l(post.published_at.to_date, format: :card),
                title: l(post.published_at, format: :long) %>
        <% else %>
          <%= post_status_badge(post) %>
          <% if post.scheduled? %>
            <%= time_tag post.scheduled_at, t(".scheduled_for", time: l(post.scheduled_at, format: :short)) %>
          <% end %>
        <% end %>
      </div>

      <h2 class="card-title text-xl leading-snug">
        <%# after:absolute after:inset-0 = ทั้งการ์ดกดได้ ด้วยลิงก์เดียว (screen reader ได้ยินแค่หัวข้อ) %>
        <%= link_to post.title, post,
              class: "after:absolute after:inset-0 focus-visible:outline-none group-hover:text-primary motion-safe:transition-colors" %>
      </h2>

      <p class="text-base-content/70 leading-relaxed line-clamp-3">
        <%= truncate(post.plain_text, length: 160, separator: /\s/) %>
      </p>

      <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-2 text-sm text-base-content/60">
        <span class="inline-flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <%= t("posts.reading_time", count: reading_minutes(post)) %>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
          </svg>
          <%= t(".comments", count: post.comments_count) %>
        </span>
        <span aria-hidden="true" class="ml-auto inline-flex items-center gap-1 font-medium text-primary motion-safe:transition-transform motion-safe:group-hover:translate-x-1">
          <%= t(".read_more") %>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </span>
      </div>
    </div>
  </article>
<% end %>
