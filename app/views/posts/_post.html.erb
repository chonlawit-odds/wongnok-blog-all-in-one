<%# locals: (post:, full: false) -%>
<article id="<%= dom_id post %>" class="card bg-base-100 border border-base-300 overflow-hidden <%= "sm:card-side" if !full && post.cover.attached? %>">
  <% if post.cover.attached? %>
    <%# รูปเป็น signed URL ของ Active Storage (redirect ไป MinIO แบบมีวันหมดอายุ) alt ว่างเพราะหัวข้ออยู่ข้าง ๆ แล้ว %>
    <% if full %>
      <figure>
        <%= image_tag post.cover.variant(:large), alt: "", class: "w-full max-h-[28rem] object-cover" %>
      </figure>
    <% else %>
      <figure class="sm:w-48 sm:shrink-0">
        <%= image_tag post.cover.variant(:thumb), alt: "", loading: "lazy", class: "w-full h-48 sm:h-full object-cover" %>
      </figure>
    <% end %>
  <% end %>

  <div class="card-body gap-3 min-w-0">
    <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
      <span class="badge badge-primary badge-soft"><%= post.category.name %></span>
      <% if post.published? %>
        <%= time_tag post.published_at,
              t(".posted_ago", time: time_ago_in_words(post.published_at)),
              title: l(post.published_at, format: :long) %>
      <% else %>
        <%= post_status_badge(post) %>
        <% if post.scheduled? %>
          <%= time_tag post.scheduled_at, t(".scheduled_for", time: l(post.scheduled_at, format: :short)) %>
        <% end %>
      <% end %>
    </div>

    <% if full %>
      <%# แก้หัวข้อแบบ inline: id = dom_id(post, :title) ตรงกับ posts/edit.html+turbo_frame.erb
          (ไม่ใช้ dom_id(post) เฉย ๆ เพราะ <article> ด้านบนใช้ id นั้นแล้ว) %>
      <%= turbo_frame_tag post, :title, class: "block" do %>
        <div class="flex items-start justify-between gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold leading-snug"><%= post.title %></h1>
          <%= link_to t(".edit_title"), edit_post_path(post), class: "btn btn-ghost btn-sm shrink-0" %>
        </div>
      <% end %>
      <%# Action Text sanitize HTML ให้เองตอน render (ตัด <script>/onclick ฯลฯ) ห้าม raw/html_safe %>
      <div class="leading-relaxed"><%= post.body %></div>
    <% else %>
      <h2 class="card-title text-xl">
        <%= link_to post.title, post, class: "link link-hover" %>
      </h2>
      <p class="text-base-content/80 leading-relaxed">
        <%= truncate(post.plain_text, length: 160, separator: /\s/) %>
      </p>
    <% end %>
  </div>
</article>
