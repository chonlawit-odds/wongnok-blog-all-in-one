<% content_for :title, t(".title") %>

<div class="w-full max-w-3xl mx-auto">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success mb-6"><%= notice %></div>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold"><%= t(".title") %></h1>
    <%= link_to t(".new_post"), new_post_path, class: "btn btn-primary" %>
  </div>

  <div role="tablist" class="tabs tabs-box mb-6">
    <%= link_to t(".tab_published"), posts_path, role: "tab",
          class: class_names("tab", "tab-active": !@pending), aria: { selected: !@pending } %>
    <%= link_to t(".tab_pending"), posts_path(view: "pending"), role: "tab",
          class: class_names("tab", "tab-active": @pending), aria: { selected: @pending } %>
  </div>

  <div id="posts" class="space-y-4">
    <%= render(@posts) || tag.p(t(@pending ? ".empty_pending" : ".empty"), class: "text-center text-base-content/60 my-10") %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>

  <div class="mt-10">
    <%= render "followers/form", follower: @follower %>
  </div>
</div>
