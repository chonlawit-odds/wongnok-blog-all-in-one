<%# locals: (post:, categories:) -%>
<%= form_with(model: post, class: "contents") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" role="alert" class="alert alert-error alert-soft flex-col items-start mt-3">
      <h2 class="font-medium"><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul class="list-disc ml-6">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, class: "label mb-2" %>
    <%= form.text_field :title, class: ["input w-full", {"input-error": post.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :body, class: "label mb-2" %>
    <%= form.rich_textarea :body, class: ["trix-content min-h-60", {"border-error": post.errors[:body].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :cover, class: "label mb-2" %>
    <%# โชว์เฉพาะรูปที่บันทึกแล้ว: ถ้าเพิ่งเลือกไฟล์ใหม่แต่ validate ไม่ผ่าน ไฟล์นั้นอาจไม่ใช่รูป %>
    <% if post.cover.attached? && post.cover.persisted? %>
      <%= image_tag post.cover.variant(:thumb), alt: "", class: "mb-3 h-32 w-auto rounded-box border border-base-300" %>
    <% end %>
    <%# direct_upload: เบราว์เซอร์อัปไฟล์ขึ้น MinIO (:9000) ตรง ไม่ผ่าน Rails  accept แค่ช่วยกรองตอนเลือกไฟล์ ของจริงตรวจที่ model %>
    <%= form.file_field :cover, direct_upload: true, accept: Post::COVER_CONTENT_TYPES.join(","),
          class: ["file-input w-full", {"file-input-error": post.errors[:cover].any?}] %>
    <p class="mt-1 text-sm text-base-content/60"><%= t(".cover_hint", size: number_to_human_size(Post::COVER_MAX_SIZE)) %></p>
  </div>

  <div class="my-5">
    <%= form.label :category_id, class: "label mb-2" %>
    <%# prompt ขึ้นเฉพาะตอนยังไม่ได้เลือก (โพสต์ใหม่) ถ้าไม่เลือก belongs_to จะใส่ error ไว้ที่ :category ไม่ใช่ :category_id %>
    <%= form.collection_select :category_id, categories, :id, :name, { prompt: t(".category_prompt") },
          class: ["select w-full", {"select-error": post.errors[:category].any?}] %>
  </div>

  <%# เผยแพร่แล้วเลือกสถานะไม่ได้อีก  ส่วน "เผยแพร่ทันที" เป็นปุ่มในหน้า show (เข้าคิว PublishPostJob)
      เช็ก published_at ด้วย: ถ้ามีคนส่ง status=published มาเอง ค่าในหน่วยความจำเป็น published แต่ยังไม่มีเวลาเผยแพร่ %>
  <% if post.published? && post.published_at? %>
    <p class="my-5 text-sm text-base-content/60">
      <%= t(".published_at", time: l(post.published_at, format: :long)) %>
    </p>
  <% else %>
    <fieldset class="fieldset my-5">
      <legend class="fieldset-legend"><%= t(".publishing") %></legend>

      <label class="label cursor-pointer gap-2">
        <%= form.radio_button :status, "draft", class: "radio radio-sm" %>
        <%= t(".status_draft") %>
      </label>
      <label class="label cursor-pointer gap-2">
        <%= form.radio_button :status, "scheduled", class: "radio radio-sm" %>
        <%= t(".status_scheduled") %>
      </label>

      <%= form.label :scheduled_at, class: "label mt-2" %>
      <%# datetime-local ไม่มีโซนเวลา Rails ตีความเป็น config.time_zone (Asia/Bangkok) %>
      <%= form.datetime_field :scheduled_at, include_seconds: false,
            class: ["input w-full sm:w-auto", {"input-error": post.errors[:scheduled_at].any?}] %>
      <p class="text-sm text-base-content/60"><%= t(".scheduled_at_hint") %></p>
    </fieldset>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary w-full sm:w-auto" %>
  </div>
<% end %>
