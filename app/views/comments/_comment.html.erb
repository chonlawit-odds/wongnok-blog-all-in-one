<%# locals: (comment:, viewer: nil) -%>
<%# viewer = current_user ของหน้าที่ render เอง  broadcast (render ใน job ไม่มีผู้ใช้) ไม่ส่งมา จึงไม่มีปุ่มลบ
    ปุ่มลบโชว์ตาม CommentPolicy แค่ UX  ด่านจริงคือ CommentsController#destroy หาจาก CommentPolicy.scope %>
<article id="<%= dom_id comment %>" class="rounded-box bg-base-100 text-base-content border border-base-300 p-4">
  <div class="flex flex-wrap items-baseline gap-2 text-sm">
    <span class="font-semibold"><%= comment.author_label %></span>
    <%= time_tag comment.created_at,
          t(".posted_ago", time: time_ago_in_words(comment.created_at)),
          title: l(comment.created_at, format: :long),
          class: "text-base-content/60" %>
    <% if viewer && CommentPolicy.new(viewer, comment).destroy? %>
      <%= button_to t(".destroy"), post_comment_path(comment.post_id, comment), method: :delete,
            class: "btn btn-ghost btn-xs text-error ml-auto", data: { turbo_confirm: t(".confirm_destroy") } %>
    <% end %>
  </div>
  <p class="mt-2 whitespace-pre-line break-words leading-relaxed"><%= comment.body %></p>
</article>
