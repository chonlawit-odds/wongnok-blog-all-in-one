<%# locals: (user:) -%>
<%# user = current_user (nil = ยังไม่ login) ส่งเข้ามาเป็น local  การซ่อนปุ่มในนี้เป็นแค่ UX ด่านจริงอยู่ที่ controller %>
<header class="navbar sticky top-0 z-30 bg-base-100 text-base-content border-b border-base-300 shadow-sm px-2 sm:px-4">
  <div class="navbar-start">
    <%# เมนูบนมือถือ: dropdown ของ daisyUI เปิด/ปิดด้วย focus ไม่ต้องใช้ JS %>
    <div class="dropdown sm:hidden">
      <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="<%= t(".open_menu") %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </div>
      <ul tabindex="-1" class="menu dropdown-content z-10 mt-3 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
        <li><%= link_to t(".posts"), posts_path, class: class_names("menu-active": controller_name == "posts") %></li>
        <li><%= link_to t(".categories"), categories_path, class: class_names("menu-active": controller_name == "categories") %></li>
        <% if user %>
          <li><%= link_to t(".new_post"), new_post_path %></li>
        <% end %>
      </ul>
    </div>

    <%= link_to t(".brand"), posts_path, class: "btn btn-ghost text-lg sm:text-xl font-bold" %>
  </div>

  <nav class="navbar-center hidden sm:flex" aria-label="<%= t(".main_menu") %>">
    <ul class="menu menu-horizontal gap-1 px-1">
      <li><%= link_to t(".posts"), posts_path, class: class_names("menu-active": controller_name == "posts") %></li>
      <li><%= link_to t(".categories"), categories_path, class: class_names("menu-active": controller_name == "categories") %></li>
    </ul>
  </nav>

  <div class="navbar-end gap-2">
    <% if user %>
      <%= link_to t(".new_post"), new_post_path, class: "btn btn-primary btn-sm hidden sm:inline-flex" %>
      <span class="hidden md:inline-flex items-center gap-2 text-sm">
        <span class="font-medium"><%= user.name %></span>
        <% if user.admin? %>
          <span class="badge badge-secondary badge-soft badge-sm"><%= User.human_attribute_name("role.admin") %></span>
        <% end %>
      </span>
      <%# ออกไปหน้า logout ของ Keycloak (คนละ origin) จึงปิด Turbo ให้เบราว์เซอร์ส่งฟอร์มเอง %>
      <%= button_to t(".logout"), session_path, method: :delete, class: "btn btn-ghost btn-sm",
            form: { data: { turbo: false } } %>
    <% else %>
      <%= render "sessions/login_button", label: t(".login"), button_class: "btn btn-primary btn-sm" %>
    <% end %>

    <%# ปุ่มสลับธีม: ติ๊ก = dark  logic อยู่ที่ app/javascript/controllers/theme_controller.js %>
    <label class="btn btn-ghost btn-circle swap swap-rotate" title="<%= t(".toggle_theme") %>" data-controller="theme">
      <input type="checkbox" aria-label="<%= t(".toggle_theme") %>"
             data-theme-target="toggle" data-action="change->theme#toggle">
      <%# ไอคอนพระอาทิตย์: ธีมสว่าง %>
      <svg xmlns="http://www.w3.org/2000/svg" class="swap-off size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <%# ไอคอนพระจันทร์: ธีมมืด %>
      <svg xmlns="http://www.w3.org/2000/svg" class="swap-on size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </label>
  </div>
</header>
