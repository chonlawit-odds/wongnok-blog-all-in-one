<% content_for :title, @category.name %>

<div class="w-full max-w-3xl mx-auto">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success alert-soft mb-6"><%= notice %></div>
  <% end %>

  <nav class="breadcrumbs text-sm text-base-content/70 mb-4" aria-label="<%= t(".breadcrumb") %>">
    <ul>
      <li><%= link_to t(".breadcrumb_root"), categories_path %></li>
      <li aria-current="page"><%= truncate(@category.name, length: 40) %></li>
    </ul>
  </nav>

  <article id="<%= dom_id @category %>" class="card relative overflow-hidden bg-base-100 text-base-content border border-base-300 shadow-sm">
    <%# วงกลมฟุ้ง ๆ ด้านหลัง ตกแต่งอย่างเดียว %>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 size-64 rounded-full bg-primary/15 blur-3xl"></div>

    <div class="card-body relative gap-6 p-6 sm:p-10">
      <header class="flex items-start gap-4">
        <div aria-hidden="true" class="grid size-14 shrink-0 place-items-center rounded-box bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-semibold tracking-wide text-primary"><%= t(".eyebrow") %></p>
          <h1 class="mt-1 text-3xl sm:text-4xl font-bold leading-tight tracking-tight break-words"><%= @category.name %></h1>
        </div>
      </header>

      <div class="divider my-0"></div>

      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-box bg-base-200 text-base-content p-4">
          <dt class="text-sm text-base-content/60"><%= Category.human_attribute_name(:slug) %></dt>
          <dd class="mt-1 font-mono text-lg break-all">/<%= @category.slug %></dd>
        </div>
        <div class="rounded-box bg-base-200 text-base-content p-4">
          <dt class="text-sm text-base-content/60"><%= t(".posts") %></dt>
          <dd class="mt-1 text-lg font-semibold"><%= t("categories.posts_count", count: @posts_count) %></dd>
        </div>
      </dl>
    </div>
  </article>

  <div class="flex flex-wrap items-center gap-2 mt-6">
    <%= link_to categories_path, class: "btn btn-ghost" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      <%= t(".back") %>
    <% end %>
    <div class="ml-auto flex flex-wrap gap-2">
      <%= link_to t(".edit"), edit_category_path(@category), class: "btn btn-outline" %>
      <%# ยังมีบทความอยู่ = ลบไม่ได้ (restrict_with_error) controller จะ redirect กลับหน้ารายการพร้อม alert %>
      <%= button_to t(".destroy"), @category, method: :delete, class: "btn btn-error btn-outline",
            data: { turbo_confirm: t(".confirm_destroy") } %>
    </div>
  </div>
</div>
