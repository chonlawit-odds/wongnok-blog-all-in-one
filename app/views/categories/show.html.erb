<% content_for :title, "Showing category" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success mb-5"><%= notice %></div>
  <% end %>

  <h1 class="font-bold text-4xl">Showing category</h1>

  <%= render @category %>

  <div class="flex flex-col sm:flex-row gap-2">
    <%= link_to "Edit this category", edit_category_path(@category), class: "btn" %>
    <%= link_to "Back to categories", categories_path, class: "btn btn-ghost" %>
    <%= button_to "Destroy this category", @category, method: :delete, form_class: "w-full sm:w-auto", class: "btn btn-error w-full sm:w-auto", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
