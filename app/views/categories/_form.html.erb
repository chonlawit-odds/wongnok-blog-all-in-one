<%= form_with(model: category, class: "contents") do |form| %>
  <% if category.errors.any? %>
    <div id="error_explanation" role="alert" class="alert alert-error alert-soft flex-col items-start mt-3">
      <h2 class="font-medium"><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>

      <ul class="list-disc ml-6">
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, class: "label mb-2" %>
    <%= form.text_field :name, class: ["input w-full", {"input-error": category.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :slug, class: "label mb-2" %>
    <%= form.text_field :slug, class: ["input w-full", {"input-error": category.errors[:slug].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary w-full sm:w-auto" %>
  </div>
<% end %>
