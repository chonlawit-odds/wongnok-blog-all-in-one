<% content_for :title, t(".title") %>

<div class="w-full max-w-4xl mx-auto">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success alert-soft mb-6"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div role="alert" id="alert" class="alert alert-error alert-soft mb-6"><%= alert %></div>
  <% end %>

  <section class="relative overflow-hidden rounded-box border border-base-300 bg-base-100 text-base-content shadow-sm px-6 py-10 sm:px-10 sm:py-14 mb-8">
    <%# วงกลมฟุ้ง ๆ ด้านหลัง ตกแต่งอย่างเดียว (เหมือน posts/index) %>
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-primary/15 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-12 size-72 rounded-full bg-secondary/15 blur-3xl"></div>

    <div class="relative flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xl">
        <p class="text-sm font-semibold tracking-wide text-primary"><%= t(".eyebrow") %></p>
        <h1 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight"><%= t(".title") %></h1>
        <p class="mt-3 text-base-content/70 leading-relaxed"><%= t(".tagline") %></p>
      </div>
      <%= link_to new_category_path, class: "btn btn-primary shrink-0 self-start sm:self-auto" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
        </svg>
        <%= t(".new_category") %>
      <% end %>
    </div>
  </section>

  <div id="categories">
    <% if @categories.any? %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%= render partial: "categories/category", collection: @categories, locals: { post_counts: @post_counts } %>
      </div>
    <% else %>
      <%= render "categories/empty" %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
