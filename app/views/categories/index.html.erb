<% content_for :title, t(".title") %>

<div class="w-full">
  <% if notice.present? %>
    <div role="status" id="notice" class="alert alert-success mb-5"><%= notice %></div>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <%= link_to t(".new_category"), new_category_path, class: "btn btn-primary" %>
  </div>

  <div id="categories" class="min-w-full divide-y divide-base-300 space-y-5">
    <% if @categories.any? %>
      <% @categories.each do |category| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render category %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row gap-2">
            <%= link_to t(".show"), category, class: "btn w-full sm:w-auto" %>
            <%= link_to t(".edit"), edit_category_path(category), class: "btn w-full sm:w-auto" %>
            <%= button_to t(".destroy"), category, method: :delete, form_class: "w-full sm:w-auto", class: "btn btn-error w-full sm:w-auto", data: { turbo_confirm: t(".confirm_destroy") } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center text-base-content/60 my-10"><%= t(".empty") %></p>
    <% end %>
  </div>
</div>
